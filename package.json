{
  "name": "manabi-shared-foundation",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tools/foundation.test.mjs tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-manabi-foundation --only auth,firestore --config firebase/emulator.json \"node --test tests/rules/*.test.mjs\"",
    "test:rules:admin-stage1": "firebase emulators:exec --project demo-manabi-admin-stage1 --only auth,firestore --config firebase/production-admin-stage1-emulator.json \"node --test tests/rules/production-admin-readonly-stage1.test.mjs\"",
    "build:preview": "node tools/build-site.mjs preview",
    "prepare:production": "node tools/build-site.mjs production",
    "build:both": "npm run build:preview && npm run prepare:production",
    "test:rules:admin-stage2": "firebase emulators:exec --project demo-manabi-admin-stage2 --only auth,firestore --config firebase/production-admin-stage2-nickname-emulator.json \"node --test tests/rules/production-admin-stage2-nickname.test.mjs\"",
    "test:rules:ranking-admin": "firebase emulators:exec --project demo-manabi-ranking-admin --only auth,firestore --config firebase/production-ranking-management-emulator.json \"node --test tests/rules/production-ranking-management.test.mjs\"",
    "test:rules:ranking-regression": "firebase emulators:exec --project demo-manabi-ranking-regression --only auth,firestore --config firebase/production-ranking-regression-emulator.json \"node --test tests/rules/production-admin-stage2-nickname.test.mjs\""
  },
  "devDependencies": {
    "firebase": "11.10.0",
    "firebase-tools": "13.35.1",
    "@firebase/rules-unit-testing": "4.0.1"
  }
}
