--- production-live-20261031.rules
+++ production-admin-readonly-stage1.rules
@@ -1,8 +1,39 @@
 rules_version = '2';
+// PROTOTYPE. Not deployed. Stage 1 is read-only for management data.
+// Assumptions: private/admin = {uid:string, enabled:bool, renameEnabled:false};
+// private/revocation = {after:timestamp, actor:string}; both are Console-only.
+// players keeps the currently deployed flat legacy schema and permissions.
+// Named management collections may be read by the password owner, never written.
+// Existing authenticated /players ranking reads are an explicit compatibility
+// exception, not a guarantee that all student data is private.
 
 
 service cloud.firestore {
   match /databases/{database}/documents {
+
+    // Stage 1 prototype: password owner may read management snapshots only.
+    // No admin write permissions, no new player fields, no ranking reset.
+    function adminIdentity() {
+      let role = get(/databases/$(database)/documents/productionAdmin/v1/private/admin).data;
+      return request.auth != null
+        && request.auth.token.firebase.sign_in_provider == 'password'
+        && role.enabled == true && role.uid == request.auth.uid;
+    }
+    function verifiedAdmin() {
+      return adminIdentity() && request.auth.token.auth_time * 1000 >
+        get(/databases/$(database)/documents/productionAdmin/v1/private/revocation).data.after.toMillis();
+    }
+    match /productionAdmin/v1/private/{id} {
+      allow get: if id in ['admin', 'revocation'] && adminIdentity();
+      allow list, create, update, delete: if false;
+    }
+    match /productionAdmin/v1/{collection}/{id} {
+      allow read: if collection in ['audit', 'backups', 'gameSettings', 'notices',
+        'settings', 'managementAudit', 'managementBackups', 'campaignHistory', 'rankingBackups']
+        && verifiedAdmin();
+      allow create, update, delete: if false;
+    }
+
     match /players/{playerId} {
       // ランキングはログインした人が見られる
       allow read: if request.auth != null;
