rules_version = '2';
// Dedicated PREVIEW Firebase project only. Do not deploy this file to production.
service cloud.firestore {
  match /databases/{database}/documents {
    function identity() {
      let owner = get(/databases/$(database)/documents/previewSpark/v1/private/admin).data;
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password'
        && owner.enabled == true && owner.uid == request.auth.uid;
    }
    function admin() {
      return identity() && request.auth.token.auth_time * 1000 >
        get(/databases/$(database)/documents/previewSpark/v1/private/revocation).data.after.toMillis();
    }
    function nameOK(n) {
      return n is string && n.size() >= 1 && n.size() <= 12
        && !n.matches('.*[<>\\r\\n].*') && !n.matches('^\\s.*') && !n.matches('.*\\s$');
    }
    function auditOK(a, uid, auditId, old, next) {
      return a.keys().hasOnly(['actor','at','uid','target','action','reason','backupId','beforeName','afterName'])
        && a.actor == request.auth.uid && a.at == request.time && a.uid == uid
        && a.target == 'players/' + uid && a.action == 'rename'
        && a.reason is string && a.reason.size() >= 2 && a.reason.size() <= 300
        && a.beforeName == old.nickname && a.afterName == next.nickname
        && a.backupId == next.lastBackup && next.lastAudit == auditId;
    }
    function backupOK(b, uid, old) {
      return b.keys().hasOnly(['actor','at','uid','target','kind','data'])
        && b.actor == request.auth.uid && b.at == request.time && b.uid == uid
        && b.target == 'players/' + uid && b.kind == 'rename' && b.data == old;
    }
    function renameOK(uid, old, next) {
      let a = getAfter(/databases/$(database)/documents/previewSpark/v1/audit/$(next.lastAudit)).data;
      let b = getAfter(/databases/$(database)/documents/previewSpark/v1/backups/$(next.lastBackup)).data;
      return uid != request.auth.uid && nameOK(next.nickname) && next.nickname != old.nickname
        && next.diff(old).affectedKeys().hasOnly(['nickname','lastAudit','lastBackup','adminUpdatedAt'])
        && next.adminUpdatedAt == request.time
        && !exists(/databases/$(database)/documents/previewSpark/v1/audit/$(next.lastAudit))
        && !exists(/databases/$(database)/documents/previewSpark/v1/backups/$(next.lastBackup))
        && auditOK(a, uid, next.lastAudit, old, next) && backupOK(b, uid, old);
    }
    match /previewSpark/v1/private/admin {
      allow get: if identity();
      allow list, write: if false; // Role provisioning is a console/IAM-only operation.
    }
    match /previewSpark/v1/private/revocation {
      allow get: if identity();
      allow update: if admin()
        && request.resource.data.keys().hasOnly(['after','actor'])
        && request.resource.data.after == request.time
        && request.resource.data.after > resource.data.after
        && request.resource.data.actor == request.auth.uid;
      allow list, create, delete: if false;
    }
    match /previewSpark/v1/players/{uid} {
      allow read: if admin();
      allow update: if admin() && renameOK(uid, resource.data, request.resource.data);
      allow create, delete: if false;
    }
    match /previewSpark/v1/audit/{id} {
      allow read: if admin();
      allow create: if admin()
        && auditOK(request.resource.data, request.resource.data.uid, id,
          get(/databases/$(database)/documents/previewSpark/v1/players/$(request.resource.data.uid)).data,
          getAfter(/databases/$(database)/documents/previewSpark/v1/players/$(request.resource.data.uid)).data)
        && getAfter(/databases/$(database)/documents/previewSpark/v1/players/$(request.resource.data.uid)).data.nickname
           != get(/databases/$(database)/documents/previewSpark/v1/players/$(request.resource.data.uid)).data.nickname;
      allow update, delete: if false;
    }
    match /previewSpark/v1/backups/{id} {
      allow read: if admin();
      allow create: if admin()
        && backupOK(request.resource.data, request.resource.data.uid,
          get(/databases/$(database)/documents/previewSpark/v1/players/$(request.resource.data.uid)).data)
        && getAfter(/databases/$(database)/documents/previewSpark/v1/players/$(request.resource.data.uid)).data.lastBackup == id
        && getAfter(/databases/$(database)/documents/previewSpark/v1/players/$(request.resource.data.uid)).data.nickname
           != get(/databases/$(database)/documents/previewSpark/v1/players/$(request.resource.data.uid)).data.nickname;
      allow update, delete: if false;
    }

    // Phase 2 player sync. Password-based admin Rules above remain unchanged.
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function syncScope(scope) { return scope in ['players','syncTestPlayers']; }
    function balancesOK(b) { return b is map && b.keys().hasAll(["japanese", "math", "social", "science", "english"]) && b.keys().hasOnly(["japanese", "math", "social", "science", "english"]) && b["japanese"] is int && b["japanese"] >= 0 && b["math"] is int && b["math"] >= 0 && b["social"] is int && b["social"] >= 0 && b["science"] is int && b["science"] >= 0 && b["english"] is int && b["english"] >= 0; }
    function bestOK(b) { return b is map && b.keys().hasAll(["keisan", "pref-name", "pref-place", "alphabet", "kotowaza", "distribution"]) && b.keys().hasOnly(["keisan", "pref-name", "pref-place", "alphabet", "kotowaza", "distribution"]) && b["keisan"] is int && b["keisan"] >= 0 && b["pref-name"] is int && b["pref-name"] >= 0 && b["pref-place"] is int && b["pref-place"] >= 0 && b["alphabet"] is int && b["alphabet"] >= 0 && b["kotowaza"] is int && b["kotowaza"] >= 0 && b["distribution"] is int && b["distribution"] >= 0; }
    function appearanceOK(p) {
      let a=p.appearance;
      let i=a.get('icon','cat'); let f=a.get('frame','plain');
      let si=a.get('subjectIcons',{}); let sf=a.get('subjectFrames',{});
      return a is map && a.keys().hasOnly(['icon','frame','badge','subjectIcons','subjectFrames','limitedOwned','limitedFramesOwned','volume','reduceMotion'])
        && (i in ['cat','rabbit','penguin','robot','explorer','wizard','ninja','king'] || p.owned.hasAny([i]))
        && (f in ['plain','star','crown'] || p.owned.hasAny([f]))
        && (a.get('badge',null)==null || p.titles.hasAny([a.badge]))
        && a.get('limitedOwned',[]).hasOnly(p.owned) && a.get('limitedFramesOwned',[]).hasOnly(p.owned)
        && si is map && si.keys().hasOnly(['math','social','english','japanese'])
        && (si.get('math',null)==null || si.math in ['icon-022','icon-007'] && p.owned.hasAny([si.math]))
        && (si.get('social',null)==null || si.social in ['icon-031','icon-010'] && p.owned.hasAny([si.social]))
        && (si.get('english',null)==null || si.english=='icon-032' && p.owned.hasAny([si.english]))
        && (si.get('japanese',null)==null || si.japanese=='icon-023' && p.owned.hasAny([si.japanese]))
        && sf is map && sf.keys().hasOnly(['math']) && (sf.get('math',null)==null || sf.math=='frame-11' && p.owned.hasAny(['frame-11']));
    }
    function shape(p,uid) {
      return p.schemaVersion==2 && p.uid==uid && nameOK(p.nickname) && p.status in ['active','suspended']
        && balancesOK(p.balances) && bestOK(p.best)
        && p.titles is list && p.titles.size()<=100 && p.titles.hasOnly(["keisan:3", "keisan:5", "keisan:10", "keisan:20", "pref-name:1", "pref-name:5", "pref-name:10", "pref-name:20", "pref-name:30", "pref-name:47", "pref-place:1", "pref-place:5", "pref-place:10", "pref-place:20", "pref-place:30", "pref-place:47", "alphabet:1", "alphabet:5", "alphabet:10", "alphabet:15", "alphabet:20", "alphabet:26", "kotowaza:3", "kotowaza:5", "kotowaza:10", "kotowaza:15", "kotowaza:20", "distribution:5", "distribution:10", "distribution:15", "distribution:20", "distribution:25"])
        && p.owned is list && p.owned.size()<=100 && p.owned.hasOnly(["cat", "crown", "explorer", "frame-01", "frame-02", "frame-03", "frame-04", "frame-05", "frame-06", "frame-07", "frame-08", "frame-09", "frame-10", "frame-11", "frame-12", "frame-13", "frame-14", "frame-15", "icon-005", "icon-006", "icon-007", "icon-008", "icon-009", "icon-010", "icon-011", "icon-012", "icon-013", "icon-014", "icon-015", "icon-016", "icon-017", "icon-018", "icon-019", "icon-021", "icon-022", "icon-023", "icon-024", "icon-025", "icon-026", "icon-027", "icon-028", "icon-029", "icon-030", "icon-031", "icon-032", "king", "ninja", "penguin", "plain", "rabbit", "robot", "star", "wizard"])
        && p.revision is int && p.revision>=1 && p.appearanceRevision is int && p.appearanceRevision>=0
        && p.lastDevice is string && p.lastDevice.size()>=10 && p.lastDevice.size()<=64 && appearanceOK(p);
    }
    function earnedTitles(b) { return (b["keisan"]>=20?["keisan:20", "keisan:10", "keisan:5", "keisan:3"]:(b["keisan"]>=10?["keisan:10", "keisan:5", "keisan:3"]:(b["keisan"]>=5?["keisan:5", "keisan:3"]:(b["keisan"]>=3?["keisan:3"]:[])))).concat((b["pref-name"]>=47?["pref-name:47", "pref-name:30", "pref-name:20", "pref-name:10", "pref-name:5", "pref-name:1"]:(b["pref-name"]>=30?["pref-name:30", "pref-name:20", "pref-name:10", "pref-name:5", "pref-name:1"]:(b["pref-name"]>=20?["pref-name:20", "pref-name:10", "pref-name:5", "pref-name:1"]:(b["pref-name"]>=10?["pref-name:10", "pref-name:5", "pref-name:1"]:(b["pref-name"]>=5?["pref-name:5", "pref-name:1"]:(b["pref-name"]>=1?["pref-name:1"]:[]))))))).concat((b["pref-place"]>=47?["pref-place:47", "pref-place:30", "pref-place:20", "pref-place:10", "pref-place:5", "pref-place:1"]:(b["pref-place"]>=30?["pref-place:30", "pref-place:20", "pref-place:10", "pref-place:5", "pref-place:1"]:(b["pref-place"]>=20?["pref-place:20", "pref-place:10", "pref-place:5", "pref-place:1"]:(b["pref-place"]>=10?["pref-place:10", "pref-place:5", "pref-place:1"]:(b["pref-place"]>=5?["pref-place:5", "pref-place:1"]:(b["pref-place"]>=1?["pref-place:1"]:[]))))))).concat((b["alphabet"]>=26?["alphabet:26", "alphabet:20", "alphabet:15", "alphabet:10", "alphabet:5", "alphabet:1"]:(b["alphabet"]>=20?["alphabet:20", "alphabet:15", "alphabet:10", "alphabet:5", "alphabet:1"]:(b["alphabet"]>=15?["alphabet:15", "alphabet:10", "alphabet:5", "alphabet:1"]:(b["alphabet"]>=10?["alphabet:10", "alphabet:5", "alphabet:1"]:(b["alphabet"]>=5?["alphabet:5", "alphabet:1"]:(b["alphabet"]>=1?["alphabet:1"]:[]))))))).concat((b["kotowaza"]>=20?["kotowaza:20", "kotowaza:15", "kotowaza:10", "kotowaza:5", "kotowaza:3"]:(b["kotowaza"]>=15?["kotowaza:15", "kotowaza:10", "kotowaza:5", "kotowaza:3"]:(b["kotowaza"]>=10?["kotowaza:10", "kotowaza:5", "kotowaza:3"]:(b["kotowaza"]>=5?["kotowaza:5", "kotowaza:3"]:(b["kotowaza"]>=3?["kotowaza:3"]:[])))))).concat((b["distribution"]>=25?["distribution:25", "distribution:20", "distribution:15", "distribution:10", "distribution:5"]:(b["distribution"]>=20?["distribution:20", "distribution:15", "distribution:10", "distribution:5"]:(b["distribution"]>=15?["distribution:15", "distribution:10", "distribution:5"]:(b["distribution"]>=10?["distribution:10", "distribution:5"]:(b["distribution"]>=5?["distribution:5"]:[])))))); }
    function updateShape(old,next) {
      return old.schemaVersion==2 && next.balances.keys()==old.balances.keys() && bestOK(next.best)
        && next.titles is list && next.titles.size()<=100
        && next.owned is list && next.owned.size()<=100
        && (next.appearance==old.appearance || appearanceOK(next));
    }
    function counterOK(d) {
      return d.keys().hasOnly(['earned','seedBalances','revision','updatedAt']) && balancesOK(d.earned) && d.seedBalances is map
        && d.updatedAt==request.time && d.revision is int;
    }
    function oldEarned(scope,uid,id) {
      return exists(/databases/$(database)/documents/previewSpark/v1/$(scope)/$(uid)/devices/$(id))
        ? get(/databases/$(database)/documents/previewSpark/v1/$(scope)/$(uid)/devices/$(id)).data.earned : {"japanese": 0, "math": 0, "social": 0, "science": 0, "english": 0};
    }
    function syncChange(scope,uid,old,next) {
      let d=getAfter(/databases/$(database)/documents/previewSpark/v1/$(scope)/$(uid)/devices/$(next.lastDevice)).data;
      let e=oldEarned(scope,uid,next.lastDevice);
      return updateShape(old,next) && old.status=='active' && next.revision==old.revision+1 && next.updatedAt==request.time
        && next.diff(old).affectedKeys().hasOnly(['balances','best','titles','owned','appearance','appearanceRevision','revision','lastDevice','updatedAt','lastPlayedAt'])
        && next.lastPlayedAt==request.time && d.revision==next.revision
        && next.balances["japanese"]==old.balances["japanese"]+d.earned["japanese"]-e["japanese"] && next.balances["math"]==old.balances["math"]+d.earned["math"]-e["math"] && next.balances["social"]==old.balances["social"]+d.earned["social"]-e["social"] && next.balances["science"]==old.balances["science"]+d.earned["science"]-e["science"] && next.balances["english"]==old.balances["english"]+d.earned["english"]-e["english"] && next.best["keisan"] >= old.best["keisan"] && next.best["pref-name"] >= old.best["pref-name"] && next.best["pref-place"] >= old.best["pref-place"] && next.best["alphabet"] >= old.best["alphabet"] && next.best["kotowaza"] >= old.best["kotowaza"] && next.best["distribution"] >= old.best["distribution"]
        && next.titles.hasAll(old.titles) && (next.titles==old.titles || next.titles.toSet().difference(old.titles.toSet()).hasOnly(earnedTitles(next.best)))
        && next.owned.hasAll(old.owned) && (next.owned==old.owned || (next.owned.toSet().difference(old.owned.toSet()).hasOnly(["icon-022", "icon-031", "icon-010", "icon-032", "icon-023", "icon-007", "frame-11", "frame-14"]) && (!next.owned.hasAny(["icon-022"]) || old.owned.hasAny(["icon-022"]) || next.best["keisan"]>=20) && (!next.owned.hasAny(["icon-031"]) || old.owned.hasAny(["icon-031"]) || next.best["pref-name"]>=47) && (!next.owned.hasAny(["icon-010"]) || old.owned.hasAny(["icon-010"]) || next.best["pref-place"]>=47) && (!next.owned.hasAny(["icon-032"]) || old.owned.hasAny(["icon-032"]) || next.best["alphabet"]>=26) && (!next.owned.hasAny(["icon-023"]) || old.owned.hasAny(["icon-023"]) || next.best["kotowaza"]>=20) && (!next.owned.hasAny(["icon-007"]) || old.owned.hasAny(["icon-007"]) || next.best["distribution"]>=25) && (!next.owned.hasAny(["frame-11"]) || old.owned.hasAny(["frame-11"]) || next.best["distribution"]>=25) && (!next.owned.hasAny(["frame-14"]) || old.owned.hasAny(["frame-14"]) || next.best["pref-name"]>=30)))
        && (next.appearance==old.appearance && next.appearanceRevision==old.appearanceRevision
          || next.appearanceRevision==old.appearanceRevision+1);
    }
    function createPlayer(scope,uid,p) {
      let d=getAfter(/databases/$(database)/documents/previewSpark/v1/$(scope)/$(uid)/devices/$(p.lastDevice)).data;
      return shape(p,uid) && p.keys().hasOnly(['schemaVersion','uid','nickname','status','balances','best','titles','owned','appearance','appearanceRevision','revision','lastDevice','createdAt','updatedAt','lastPlayedAt','migration'])
        && p.status=='active' && p.revision==1 && p.appearanceRevision==0 && p.createdAt==request.time && p.updatedAt==request.time && p.lastPlayedAt==request.time
        && p.migration=={'source':'preview-local-v1','deviceId':p.lastDevice}
        && d.revision==1 && p.balances["japanese"]==d.seedBalances["japanese"]+d.earned["japanese"] && p.balances["math"]==d.seedBalances["math"]+d.earned["math"] && p.balances["social"]==d.seedBalances["social"]+d.earned["social"] && p.balances["science"]==d.seedBalances["science"]+d.earned["science"] && p.balances["english"]==d.seedBalances["english"]+d.earned["english"];
    }
    function price(id) { return {"icon-005": 100, "icon-006": 100, "icon-008": 100, "icon-009": 100, "icon-011": 100, "icon-012": 100, "icon-013": 100, "icon-014": 100, "icon-015": 100, "icon-016": 100, "icon-017": 200, "icon-018": 200, "icon-019": 200, "icon-021": 200, "icon-024": 200, "icon-025": 200, "icon-026": 300, "icon-027": 300, "icon-028": 300, "icon-029": 300, "icon-030": 300, "frame-01": 50, "frame-02": 50, "frame-03": 50, "frame-04": 50, "frame-05": 50, "frame-06": 150, "frame-07": 150, "frame-08": 150, "frame-09": 150, "frame-10": 150, "frame-12": 300, "frame-13": 300, "frame-14": 300, "frame-15": 300}.get(id,0); }
    function purchaseChange(scope,uid,old,next) {
      let r=getAfter(/databases/$(database)/documents/previewSpark/v1/$(scope)/$(uid)/purchases/$(next.lastPurchase)).data;
      return old.schemaVersion==2 && balancesOK(next.balances) && old.status=='active' && next.revision==old.revision+1 && next.updatedAt==request.time
        && next.diff(old).affectedKeys().hasOnly(['balances','owned','revision','lastPurchase','updatedAt'])
        && !exists(/databases/$(database)/documents/previewSpark/v1/$(scope)/$(uid)/purchases/$(next.lastPurchase))
        && r.keys().hasOnly(['productId','subject','price','at','revision'])
        && r.productId==next.lastPurchase && r.subject in ['japanese','math','social','english'] && r.price==price(r.productId) && r.price>0 && r.at==request.time && r.revision==next.revision
        && !old.owned.hasAny([r.productId]) && next.owned.hasAll(old.owned) && next.owned.hasAny([r.productId]) && next.owned.size()==old.owned.size()+1
        && next.balances["japanese"]==old.balances["japanese"]-(r.subject=="japanese"?r.price:0) && next.balances["math"]==old.balances["math"]-(r.subject=="math"?r.price:0) && next.balances["social"]==old.balances["social"]-(r.subject=="social"?r.price:0) && next.balances["science"]==old.balances["science"]-(r.subject=="science"?r.price:0) && next.balances["english"]==old.balances["english"]-(r.subject=="english"?r.price:0);
    }
    match /previewSpark/v1/{scope}/{uid} {
      allow get: if syncScope(scope) && owner(uid);
      allow create: if syncScope(scope) && owner(uid) && createPlayer(scope,uid,request.resource.data);
      allow update: if syncScope(scope) && owner(uid) && (request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastPurchase']) ? purchaseChange(scope,uid,resource.data,request.resource.data) : syncChange(scope,uid,resource.data,request.resource.data));
      match /devices/{id} {
        allow get: if syncScope(scope) && (owner(uid) || admin());
        allow create, update: if syncScope(scope) && owner(uid) && counterOK(request.resource.data)
          && (exists(/databases/$(database)/documents/previewSpark/v1/$(scope)/$(uid)/devices/$(id)) || balancesOK(request.resource.data.seedBalances))
          && getAfter(/databases/$(database)/documents/previewSpark/v1/$(scope)/$(uid)).data.lastDevice==id
          && getAfter(/databases/$(database)/documents/previewSpark/v1/$(scope)/$(uid)).data.revision==request.resource.data.revision
          && (!exists(/databases/$(database)/documents/previewSpark/v1/$(scope)/$(uid))
            || (getAfter(/databases/$(database)/documents/previewSpark/v1/$(scope)/$(uid)).data.revision==get(/databases/$(database)/documents/previewSpark/v1/$(scope)/$(uid)).data.revision+1
              && getAfter(/databases/$(database)/documents/previewSpark/v1/$(scope)/$(uid)).data.diff(get(/databases/$(database)/documents/previewSpark/v1/$(scope)/$(uid)).data).affectedKeys().hasOnly(['balances','best','titles','owned','appearance','appearanceRevision','revision','lastDevice','updatedAt','lastPlayedAt'])
              && ((!exists(/databases/$(database)/documents/previewSpark/v1/$(scope)/$(uid)/devices/$(id)) && request.resource.data.seedBalances=={'japanese':0,'math':0,'social':0,'science':0,'english':0})
                || (request.resource.data.seedBalances==resource.data.seedBalances
                  && request.resource.data.earned.japanese>=resource.data.earned.japanese
                  && request.resource.data.earned.math>=resource.data.earned.math
                  && request.resource.data.earned.social>=resource.data.earned.social
                  && request.resource.data.earned.science>=resource.data.earned.science
                  && request.resource.data.earned.english>=resource.data.earned.english))));
      }
      match /purchases/{id} {
        allow get: if syncScope(scope) && (owner(uid) || admin());
        allow create: if syncScope(scope) && owner(uid) && request.resource.data.productId==id
          && purchaseChange(scope,uid,get(/databases/$(database)/documents/previewSpark/v1/$(scope)/$(uid)).data,getAfter(/databases/$(database)/documents/previewSpark/v1/$(scope)/$(uid)).data);
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}

